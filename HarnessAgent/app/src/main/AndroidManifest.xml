<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ─────────────────────────────────────────────────────────────
         权限
         ─────────────────────────────────────────────────────────────── -->

    <!-- 网页访问。端侧 Agent 的一切动作都在 WebView 里完成，这是核心权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 9+ 多进程 WebView 需要声明 dataDir 后缀；我们单进程但保留兼容 -->
    <!-- 前台服务：端侧推理耗时长（单步 4.5s、8 步任务 ~36s），必须保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14+ 要求前台服务声明具体类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 通知：常驻通知 + 人机交互点（确认/中止）—— 没有它用户无法在推理途中干预 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 模型下载后需读私有目录；写入只在内部存储，无需存储权限 -->

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name="com.ake.app.AkeApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HarnessAgent"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        tools:targetApi="34">

        <!-- ★★ GPU backend 的隐藏依赖 —— 架构师核实的真实坑 ★★
             目标 Android 12（API 31+）的应用无法加载未声明的厂商原生库。
             缺失时 `Engine.initialize()` **会成功返回**，但第一条消息以
             "Can not find OpenCL library on this device" 失败。
             症状是「模型加载成功但永远不吐字」，极难归因。
             （配合 :llm 的预热探针，缺声明时能立刻降级到 CPU 而不是卡死。） -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name="com.ake.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 允许把一段文字分享进 App 作为任务 goal -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 端侧推理前台服务：任务执行期间保持进程存活 -->
        <service
            android:name="com.ake.app.execution.AgentExecutionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs on-device Gemma 4 inference to complete browser tasks requested by the user." />
        </service>

        <!-- 模型下载前台服务（2.6 GB，会持续很久，必须可见可取消） -->
        <service
            android:name="com.ake.app.download.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Downloads the on-device Gemma 4 model file requested by the user." />
        </service>

    </application>

</manifest>
